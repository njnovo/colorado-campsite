# Copy this file to .env and fill in values. .env is not committed.

# Free key from https://ridb.recreation.gov (sign up -> profile -> API key)
RIDB_API_KEY=

# Sent in our User-Agent so source sites can contact us (PLAN.md §3.5)
CONTACT_EMAIL=

# Recreation.gov's robots.txt disallows /api/*. Leave false until access is sanctioned.
RECGOV_AVAILABILITY_ENABLED=false

# Watched campgrounds are polled this many days ahead (manage.py watch add ...)
# WATCH_DAYS=90

# HOST=127.0.0.1
# PORT=8000
# DB_PATH=data/campsites.db
